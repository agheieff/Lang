# Whitelist: ignore everything, reopen directories, then allow project files explicitly.
*
!*/

!/.gitignore
!/AGENTS.md
!/README.md
!/pyproject.toml
!/uv.lock
!/uv.toml
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/biome.json
!/run.sh
!/run_tests.sh
!/scripts/**/*.sh
!/scripts/**/*.py
!/scripts/**/*.service
!/config/**/*.toml

!/server/**/*.py
!/server/grammar_catalogs/**/*.toml
!/server/language_rules/**/*.toml
!/server/word_lists/**/*.tsv
!/server/word_lists/**/*.txt
!/server/word_lists/**/*.md
!/server/templates/**/*.html
!/web/**/*.ts
!/web/**/*.css
!/tests/**/*.py
!/tests/**/*.json
!/examples/**/*.json

# Runtime and tool state stay private even though directories are reopened above.
/.lang/
/.mypy_cache/
/.pytest_cache/
/.ruff_cache/
/.venv/
/data/
/node_modules/
/server/static/
